---
// The three community subpages, as buttons on Community and on each subpage, to switch between them.
// They are also in the Community dropdown of the main menu (user, 2026-11-06).
const { path = '' } = Astro.props;
export const pages = [
  ['Individuals', '/individuals'],
  ['Organisations', '/organisations'],
  ['Educational Projects', '/educational-projects'],
];
---
<ul class="pills">
  {pages.map(([label, href]) => (
    <li><a href={href} class={href === path ? 'on' : ''} aria-current={href === path ? 'page' : undefined}>{label}</a></li>
  ))}
</ul>
