---
import Base from '../layouts/Base.astro';
---
<Base title="Video for the Survey | ECiME" description="Introduction video for the ECiME survey on instrumental music teaching and learning in early childhood." path="/video4survey">
  <section class="wrap" style="padding-top:48px">
    <video controls preload="metadata" playsinline style="width:100%;max-width:960px;display:block;background:#000">
      <source src="/video/survey.mp4" type="video/mp4" />
    </video>
    <p style="margin-top:24px"><a class="button" href="/survey">Back to survey</a></p>
  </section>
</Base>
