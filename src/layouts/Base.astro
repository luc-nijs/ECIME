---
import '../styles/site.css';
import { nav, FACEBOOK } from '../data/nav.js';

interface Props {
  title: string; description?: string; path: string; noindex?: boolean;
  // Page header: a title, an optional line under it, and an optional photo that fades behind it.
  heading?: string; lead?: string; image?: string; home?: boolean;
}
const { title, description = '', path, noindex = false, heading, lead, image, home = false } = Astro.props;

const site = Astro.site ?? 'https://www.ecime.org';
const canonical = new URL(path === '/' ? '/' : `${path}/`, site).href;
const ogImage = new URL('/images/home.jpg', site).href;
const siteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ECiME: Early Childhood Instrumental Music Education',
  url: new URL('/', site).href,
  description: 'Knowledge and experiences about instrumental music teaching and learning in early childhood.',
  author: {
    '@type': 'Person',
    name: 'Luc Nijs',
    url: 'https://www.lucnijs.be',
    worksFor: { '@type': 'CollegeOrUniversity', name: 'University of Luxembourg' },
  },
};

// A page in a dropdown keeps its parent highlighted, as on the Wix site.
const isOn = (item) => item.href === path || (item.children ?? []).some((c) => c.href === path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ECiME" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(siteData).replace(/</g, '\\u003c')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Manrope:wght@300..700&display=swap" rel="stylesheet" />
  </head>
  <body class={home ? 'is-home' : ''}>
    <header class="top">
      <div class="top-in">
        <a class="logo" href="/" aria-label="ECiME home">ECi<span>ME</span></a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menu" />
        <label for="menu-toggle" class="menu-button" aria-hidden="true"><span></span></label>
        <nav aria-label="Main">
          <ul class="menu">
            {nav.map((item) => (
              <li class={item.children ? 'has-sub' : ''}>
                <a href={item.href} class={isOn(item) ? 'on' : ''}>{item.label}</a>
                {item.children && (
                  <ul class="sub">
                    {item.children.map((c) => <li><a href={c.href} class={c.href === path ? 'on' : ''}>{c.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      {heading && (
        <section class={`hero ${home ? 'hero-home' : ''} ${image ? 'has-image' : ''}`}>
          {image && <img class="hero-img" src={image} alt="" />}
          <div class="hero-text">
            <h1 set:html={heading} />
            {lead && <p class="lead" set:html={lead} />}
          </div>
        </section>
      )}
      <slot />
    </main>
    <footer>
      <div class="foot">
        <span>© 2024 by Luc Nijs</span>
        <a href={FACEBOOK} target="_blank" rel="noopener">Facebook group →</a>
      </div>
    </footer>
  </body>
</html>
